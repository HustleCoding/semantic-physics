{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vite/client"],
    "skipLibCheck": true
  },
  "include": ["src", "shared", "worker", "test", "vite.config.ts"]
}
